Important: This chart assumes the male and female columns represent mutually exclusive counts of the same type. Check the source table before interpreting the stacked totals.

Step 17: Pie Chart — Age Group Distribution

# Keep only non-negative age-group totals
age_labels = [
    age for age, count in age_groups.items()
    if pd.notna(count) and count > 0
]

age_values = [
    age_groups[age] for age in age_labels
]

if age_values:
    plt.figure(figsize=(8, 8))

    plt.pie(
        age_values,
        labels=age_labels,
        autopct='%1.1f%%',
        startangle=90
    )

    plt.title('Distribution of Counts by Age Group')
    plt.axis('equal')
    plt.show()
else:
    print("No positive age-group totals are available.")

