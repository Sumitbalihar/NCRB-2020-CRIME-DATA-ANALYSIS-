display(df.describe(include='all'))

Step 4: Clean the Dataset

The following code removes unnecessary spaces from column names and removes a summary row if one exists.

# Remove extra spaces from column names
df.columns = df.columns.astype(str).str.strip()

# Remove completely empty rows
df.dropna(how='all', inplace=True)

# Reset the index
df.reset_index(drop=True, inplace=True)

print("Dataset after cleaning:")
display(df.head())

print("Dataset Shape:", df.shape)

Step 5: Rename Columns

Important: This step assumes your Excel sheet contains exactly 20 columns in the order shown below. If the actual column names or order differ, update the mapping accordingly.

expected_columns = [
    'Index', 'City', 'Boys', 'Girls', 'Juvenile_Total',
    'M_18_30', 'F_18_30', 'Total_18_30',
    'M_30_45', 'F_30_45', 'Total_30_45',
    'M_45_60', 'F_45_60', 'Total_45_60',
    'M_60_plus', 'F_60_plus', 'Total_60_plus',
    'Total_Male', 'Total_Female', 'Grand_Total'
]

if len(df.columns) == len(expected_columns):
    df.columns = expected_columns
else:
    raise ValueError(
        f"Expected 20 columns, but found {len(df.columns)}. "
        "Check the Excel sheet and update the column names."
    )

print("Column Names:")
print(df.columns.tolist())

Step 6: Remove Summary Rows

# Remove summary rows such as Total Cities
df = df[
    ~df['City'].astype(str).str.strip().str.lower().isin(
        ['total cities', 'total city', 'total']
    )
].copy()

# Remove rows without a city name
df = df[
    df['City'].notna() &
    (df['City'].astype(str).str.strip() != '')
].copy()

df.reset_index(drop=True, inplace=True)

print("Dataset after removing summary rows:")
display(df.head())

Step 7: Convert Columns to Numeric

# Convert numeric columns
numeric_cols = [
    col for col in df.columns
    if col != 'City'
]

for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Display missing values
print("Missing Values Before Treatment:")
print(df.isnull().sum())

Step 8: Handle Missing Values

# Fill missing numeric values with column means
for col in numeric_cols:
    if df[col].notna().any():
        df[col] = df[col].fillna(df[col].mean())

print("Missing Values After Treatment:")
print(df.isnull().sum())

Note: Mean imputation is suitable for some exploratory analyses, but it can distort crime totals. For official reporting, investigate missing values and avoid treating unknown counts as actual crime counts.

Step 9: Create New Features

# Gender ratio
df['Gender_Ratio'] = (
    df['Total_Male'] /
    df['Total_Female'].replace(0, np.nan)
)

# Juvenile percentage
df['Juvenile_Percent'] = np.where(
    df['Grand_Total'] > 0,
    (df['Juvenile_Total'] / df['Grand_Total']) * 100,
    np.nan
)

print("New Features:")
display(
    df[['City', 'Gender_Ratio', 'Juvenile_Percent']].head()
)

Step 10: Calculate Total Crime Counts

total_male = df['Total_Male'].sum()
total_female = df['Total_Female'].sum()
grand_total = df['Grand_Total'].sum()

print("Total Male Crimes:", total_male)
print("Total Female Crimes:", total_female)
print("Overall Crimes:", grand_total)

These totals represent the sum of the corresponding columns in your dataset. Confirm the definitions in the original NCRB table before interpreting them as separate crime counts.

